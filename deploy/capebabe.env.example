# /etc/capebabe.env (root-only: chmod 600). Read by capebabe.service.
# The password friends type on the "Connect to a server" page. Keep it out of the repo.
CAPEBABE_WORLD_PASSWORD=change-me
# Listen on the Tailscale address only (`tailscale ip -4`), give admin commands to just these players,
# and pick the world. Backups go to /var/lib/capebabe/backups every 24h, newest 7 kept
# (--backups DIR --backup-hours H --keep-backups N to change; --backup-hours 0 = off).
CAPEBABE_ARGS=--bind 100.64.0.1 --admins phili --world 1
